{
  "name": "swiftui-canvas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli.js && chmod +x dist/cli.js",
    "build:cli:watch": "esbuild cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --watch",
    "pretest": "npm run typecheck",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --outfile=dist/mcp.js --define:__MCP_ENTRY__=true"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0"
  },
  "description": "Sketch SwiftUI screens in the browser and turn them into vibe-coding prompts.",
  "license": "MIT",
  "bin": {
    "swiftui-canvas": "./dist/cli.js",
    "swiftui-canvas-mcp": "./dist/mcp.js"
  },
  "type": "module"
}